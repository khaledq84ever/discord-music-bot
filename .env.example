# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Public Application/Client ID (Developer Portal → General Information).
# Used only to build the "Add to Discord" invite link.
APPLICATION_ID=

# Optional: a test server ID so slash commands sync instantly (global sync
# can take up to ~1 hour to propagate).
DEV_GUILD_ID=

# Optional tuning
IDLE_TIMEOUT=300
DEFAULT_VOLUME=0.5
